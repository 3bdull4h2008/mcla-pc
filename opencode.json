{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-antigravity-auth@latest",
    "dynamic-context-pruning@latest",
    "opencode-worktree@latest",
    "opencode-firecrawl@latest",
    "opencode-notify@latest",
    "tokenscope@latest",
    "morph-fast-apply@latest",
    "opencode-skillful@latest",
    "opencode-pty@latest"
  ],
  "instructions": [
    ".opencode/rules/coding-standards.md",
    ".opencode/rules/workflow.md",
    ".opencode/rules/ghidra-mcp.md",
    ".opencode/rules/gpu-tooling-mcp.md",
    ".opencode/rules/context-management.md"
  ],
  "default_agent": "gpu-engineer",
  "references": {
    "architecture": {
      "path": ".opencode/docs/architecture.md",
      "description": "Architecture brainmap, flowcharts, and component navigation for MCLA native GPU backend"
    }
  },
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "C:\\Users\\abdul\\.local\\bin\\bridge-mcp-ghidra.exe",
        "--lazy",
        "--default-groups",
        "listing,function,program,xref,analysis,documentation"
      ],
      "timeout": 30000,
      "enabled": true
    },
    "renderdoc": {
      "type": "local",
      "command": [
        "C:\\Users\\abdul\\.local\\share\\mcp\\rdmcp-venv\\Scripts\\renderdoc-mcp.exe"
      ],
      "timeout": 30000,
      "enabled": true
    },
    "pix": {
      "type": "local",
      "command": [
        "C:\\Users\\abdul\\.local\\share\\mcp\\pix-mcp\\pix-mcp.exe"
      ],
      "environment": {
        "PIXTOOL_PATH": "C:\\Program Files\\Microsoft PIX\\2603.25\\pixtool.exe"
      },
      "timeout": 30000,
      "enabled": true
    }
  },
  "tools": {
    "ghidra_*": false,
    "renderdoc_*": false,
    "pix_*": false
  },
  "lsp": {
    "clangd": {
      "command": ["C:\\Program Files\\LLVM\\bin\\clangd.exe", "--background-index", "--clang-tidy", "--completion-style=detailed"],
      "enabled": true,
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hxx"]
    },
    "pyright": {
      "command": ["C:\\Users\\abdul\\.local\\bin\\pyright-langserver.exe", "--stdio"],
      "enabled": true,
      "extensions": [".py"]
    },
    "pylsp": {
      "command": ["C:\\Users\\abdul\\.local\\bin\\pylsp.exe"],
      "enabled": true,
      "extensions": [".py"]
    }
  },
  "compaction": { "auto": false, "prune": false },
  "experimental": { "batch_tool": true },
  "tool_output": { "max_lines": 500, "max_bytes": 24576 },
  "agent": {
    "gpu-engineer": {
      "description": "Native D3D12 renderer implementation",
      "mode": "primary",
      "system": "MCLA Native PC GPU Renderer — see AGENTS.md and .opencode/rules/*.md",
      "permissions": [
        { "action": "edit", "resource": "generated/**", "effect": "deny" },
        { "action": "shell", "resource": "cmake *", "effect": "allow" },
        { "action": "shell", "resource": "ninja *", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "ask" }
      ],
      "tools": { "renderdoc_*": true, "pix_*": true, "subagent": true, "skill": true }
    },
    "reverser": {
      "description": "PPC/recomp analysis, guest struct discovery",
      "mode": "subagent",
      "tools": { "ghidra_*": true, "skill": true, "subagent": false }
    },
    "architect": {
      "description": "System design, phase planning, ownership decisions",
      "mode": "primary",
      "tools": { "ghidra_*": true, "skill": true, "subagent": true }
    },
    "shader-translator": {
      "description": "Xenos microcode decode, IR, HLSL/DXIL codegen",
      "mode": "subagent",
      "tools": { "renderdoc_*": true, "skill": true, "subagent": false }
    },
    "perf-engineer": {
      "description": "GPU/CPU perf, upload/cache tuning, frame pacing",
      "mode": "primary",
      "tools": { "renderdoc_*": true, "pix_*": true, "skill": true, "subagent": true }
    },
    "debugger": {
      "description": "Crash/assert/D3D12 validation-warning triage",
      "mode": "subagent",
      "tools": { "ghidra_*": true, "renderdoc_*": true, "pix_*": true, "skill": true }
    },
    "security-auditor": {
      "description": "Read-only memory-safety audit: OOB, bounds, endianness",
      "mode": "subagent",
      "tools": { "ghidra_*": true, "skill": true }
    },
    "code-reviewer": {
      "description": "Read-only PR/diff review, convention + hook-ownership checks",
      "mode": "subagent",
      "tools": { "ghidra_*": true, "skill": true }
    },
    "build-specialist": {
      "description": "CMake/clang-cl/MSVC toolchain, linker, ABI issues",
      "mode": "subagent",
      "tools": { "skill": true }
    },
    "test-engineer": {
      "description": "Offline validators, smoke gates, corpus regression checks",
      "mode": "subagent",
      "tools": { "skill": true }
    },
    "docs-writer": {
      "description": "Plan docs, handoff notes, phase reports",
      "mode": "subagent",
      "tools": { "skill": true }
    },
    "research-scout": {
      "description": "External reference research (Xenia, XenosRecomp, UnleashedRecomp)",
      "mode": "subagent",
      "tools": { "skill": true }
    },
    "node-tooling": {
      "description": "Manifest/database and node tooling side",
      "mode": "subagent",
      "tools": { "skill": true }
    },
    "memory-steward": {
      "description": "Architecture brainmap, knowledge graph, handoff continuity",
      "mode": "subagent",
      "tools": { "skill": true }
    }
  }
}